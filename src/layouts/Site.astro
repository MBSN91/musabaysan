---
import '../styles/v2.css';
import logoRaw from '../icons/logo.svg?raw';

interface Props { title: string; description: string; path?: string }
const { title, description, path = '/' } = Astro.props;
const logo = logoRaw.replace(/<\?xml[^>]*>/, '').replace(/<!--[\s\S]*?-->/g, '')
	.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const email = 'hello@musabaysan.nl';
const linkedin = 'https://www.linkedin.com/in/musabaysan';
const onHome = path === '/';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f9f4f0" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#05192d" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`https://www.musabaysan.nl${path}`} />
		<link rel="canonical" href={`https://www.musabaysan.nl${path}`} />
		<link rel="icon" type="image/svg+xml" href="/favicon-m.svg" />
		<link rel="preload" href="/fonts/archivo-wdth.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline async src="https://cdn.seline.so/seline.js" data-token="5729609278daf4f"></script>
		<script is:inline>
			(function () {
				var t = null;
				try { t = localStorage.getItem('theme'); } catch (e) {}
				if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				document.documentElement.dataset.theme = t;
				try { if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion'); } catch (e) {}
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<header class="bar">
			<a class="bar__logo" href="/" aria-label="Musa Baysan, home" set:html={logo} />
			<nav class="bar__nav" aria-label="Main">
				<a href={onHome ? '#work' : '/#work'}>Work</a>
				<a href={onHome ? '#about' : '/#about'}>About</a>
				<a href={onHome ? '#contact' : '/#contact'}>Contact</a>
				<button class="theme" type="button" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
					<svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
					<svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
				</button>
			</nav>
		</header>

		<main id="main"><slot /></main>

		<footer class="end" id="contact">
			<div class="end__ask">
				<h2>Got a role or a project?</h2>
				<p>Tell me what you are working on, and I will get back to you.</p>
				<form class="ask" action={`mailto:${email}`} method="get" enctype="text/plain">
					<label class="sr" for="ask-msg">Your message</label>
					<input id="ask-msg" name="body" type="text" placeholder="Hi Musa, …" autocomplete="off" />
					<input type="hidden" name="subject" value="Hello from musabaysan.nl" />
					<button class="btn" type="submit">Send by email</button>
				</form>
				<dl class="ways">
					<div><dt>Email</dt><dd><a class="u" href={`mailto:${email}`}>{email}</a></dd></div>
					<div><dt>LinkedIn</dt><dd><a class="u" href={linkedin} rel="noopener" target="_blank">linkedin.com/in/musabaysan</a></dd></div>
					<div><dt>Based in</dt><dd>Breda, the Netherlands</dd></div>
				</dl>
			</div>
			<div class="end__mark" set:html={logo} />
			<p class="end__small">© 2026 Musa Baysan. Designed and built by me, in Astro.</p>
		</footer>

		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
