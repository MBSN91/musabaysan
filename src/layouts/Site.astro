---
import '../styles/reel.css';
import logoRaw from '../icons/logo.svg?raw';
import SecBar from '../components/SecBar.astro';

interface Props { title: string; description: string; path?: string; barInk?: string }
const { title, description, path = '/', barInk } = Astro.props;
const logo = logoRaw.replace(/<\?xml[^>]*>/, '').replace(/<!--[\s\S]*?-->/g, '')
	.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const email = 'hello@musabaysan.nl';
const linkedin = 'https://www.linkedin.com/in/musabaysan';
const onHome = path === '/';
const nav = [
	{ href: onHome ? '#work' : '/#work', label: 'Work' },
	{ href: onHome ? '#about' : '/#about', label: 'About' },
	{ href: '#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#000000" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={`https://www.musabaysan.nl${path}`} />
		<link rel="canonical" href={`https://www.musabaysan.nl${path}`} />
		<link rel="icon" type="image/svg+xml" href="/favicon-m.svg" />
		<link rel="preload" href="/fonts/russo-one-400.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/tomorrow-400.woff2" as="font" type="font/woff2" crossorigin />
		<script is:inline async src="https://cdn.seline.so/seline.js" data-token="5729609278daf4f"></script>
		<script is:inline>
			(function () {
				var d = document.documentElement, t = null, m = false;
				try { t = localStorage.getItem('theme'); } catch (e) {}
				d.dataset.theme = t === 'light' ? 'light' : 'dark';
				if (t === 'light') document.querySelector('meta[name="theme-color"]').setAttribute('content', '#ffffff');
				try { m = !matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
				if (m) {
					d.classList.add('motion');
					try { if (sessionStorage.getItem('curtain')) d.classList.add('arriving'); } catch (e) {}
				}
			})();
		</script>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<div class="cursor" aria-hidden="true"><span class="cursor__label">View</span></div>
		<div class="curtain" aria-hidden="true"><span class="curtain__label" data-curtain-label></span></div>

		<div id="smooth-wrapper">
			<div id="smooth-content">
				<header class:list={['bar', { 'bar--overlay': !!barInk }]} style={barInk ? `--bar-ink:${barInk}` : undefined}>
					<a class="bar__logo" href="/" aria-label="Musa Baysan, home" set:html={logo} />
					<nav class="bar__nav" aria-label="Main">
						{nav.map((n) => (
							<a href={n.href}><span class="roll" data-text={n.label}><span>{n.label}</span></span></a>
						))}
						<button class="theme" type="button" data-theme-toggle aria-label="Light theme" aria-pressed="false">
							<svg class="theme__sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
							<svg class="theme__moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
						</button>
					</nav>
				</header>

				<main id="main"><slot /></main>

				<footer class="end" id="contact" data-panel>
					{onHome && <SecBar n={5} label="Contact" meta={email} />}
					<h2 class="end__title" data-fit data-unstretch><span data-fit-text>Say hi.</span></h2>
					<p class="end__lead">Got a role or a project? Tell me what you are working on, and I will get back to you.</p>
					<a class="end__mail" href={`mailto:${email}`} data-magnetic><span class="roll" data-text={email}><span>{email}</span></span></a>
					<dl class="ways">
						<div><dt>LinkedIn</dt><dd><a class="u" href={linkedin} rel="noopener" target="_blank">linkedin.com/in/musabaysan</a></dd></div>
						<div><dt>Based in</dt><dd>Breda, the Netherlands</dd></div>
					</dl>
					<p class="end__small">© 2026 Musa Baysan. Designed and built by me, in Astro.</p>
				</footer>
			</div>
		</div>

		<script>
			import '../scripts/site';
		</script>
	</body>
</html>
