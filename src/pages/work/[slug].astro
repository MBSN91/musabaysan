---
// Case pages. This is where the sketch-to-shipped plotting lives: each real screen draws as its dotted
// wireframe first, then prints as the shipped screen. adidas only ever shows the redrawn wireframe.
import Site from '../../layouts/Site.astro';
import Shot from '../../components/Shot.astro';
import Device from '../../components/Device.astro';
import { cases } from '../../data/work';

export const prerender = true;

export function getStaticPaths() {
	return cases.map((c, i) => ({ params: { slug: c.slug }, props: { c, next: cases[(i + 1) % cases.length] } }));
}
const { c, next } = Astro.props;
---
<Site title={`${c.name}: ${c.title} · Musa Baysan`} description={c.summary} path={`/work/${c.slug}/`}>
	<article class="cs" style={`--field:${c.field};--on-field:${c.ink}`}>
		<header class="cs__head">
			<h1 data-split>{c.title}</h1>
			<p class="cs__name">{c.name}</p>
			<p class="cs__lead">{c.summary}</p>
			<dl class="cs__facts">
				{c.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
			</dl>
		</header>

		<div class="cs__cover" data-panel data-cover>
			{c.slug === 'adidas-store-app' ? (
				<div class="adi">
					<div class="metric" data-metric>
						<p class="metric__from"><s>5 to 8</s> min</p>
						<p class="metric__to"><span data-roll>1.5</span> min</p>
						<p class="metric__note">Bulk scanning in store tests, before and after</p>
					</div>
					<Device wire="adidas-bulkscan" id="cs-bulkscan" alt="Wireframe of a bulk-scan screen: a scan counter, a list of scanned items and a done button" caption="Redrawn as a wireframe. The real screens are confidential." />
				</div>
			) : c.cover.kind === 'device' ? (
				<Device id="cover-device" wire={c.cover.wire} img={c.cover.img} alt={c.cover.alt} eager
					notes={[
						{ text: 'One score for the day', x: 50, y: 41, side: 'r' },
						{ text: 'Protein, sleep, steps', x: 70, y: 62, side: 'r' },
						{ text: 'Today’s workout, one tap', x: 85, y: 80, side: 'r' },
					]} />
			) : <Shot shot={c.cover} eager />}
		</div>

		{c.sections.map((s, i) => (
			<section class:list={['cs__part', { 'cs__part--flip': i % 2 }]}>
				<div class="cs__copy">
					<h2 data-split>{s.heading}</h2>
					{s.body.map((p) => <p>{p}</p>)}
				</div>
				{s.shot && <div class="cs__shot"><Shot shot={s.shot} /></div>}
			</section>
		))}

		{c.slug === 'adidas-store-app' && (
			<section class="cs__part">
				<div class="cs__copy">
					<h2 data-split>What I can show in a call</h2>
					<p>The screens are confidential. In a call I walk you through the flows, the research and the decisions behind them.</p>
				</div>
				<div class="cs__shot"><Shot shot={c.cover} /></div>
			</section>
		)}

		<nav class="cs__next" aria-label="More work">
			<a href={`/work/${next.slug}/`} data-curtain={next.name} data-cursor="view">
				<span class="cs__next-label">Next case, {next.name}</span>
				<strong>{next.title}</strong>
			</a>
			<p class="cs__all"><a class="u" href="/#work">All work</a></p>
		</nav>
	</article>
</Site>
