# Old pages from the 2023 site point to the holding page (Oct 2026).
# Their source lives in src/legacy/. The Astro Netlify adapter appends its own rules below these.
/home          /    301
/cases/happy   /    301
# Happy Italy was split into an app and a website case (Nov 2026). Unknown case pages go home instead of
# rendering the last case. Real case pages are static files, which Netlify serves before these rules.
/work/happy-italy    /work/happy-italy-app/   301
/work/happy-italy/*  /work/happy-italy-app/   301
# Private cases: the full page is rendered by the server function (src/pages/work/[slug]/full.astro).
/work/:slug/full     /.netlify/functions/entry  200
/work/:slug/full/    /.netlify/functions/entry  200
/work/*              /                        302
