# Postgres connection string
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/musabaysan
# Long random string; signs logins
PAYLOAD_SECRET=
# Netlify build hook URL. Publishing in the editor calls it, which rebuilds musabaysan.nl. Leave empty locally.
NETLIFY_BUILD_HOOK=
# Optional: S3-compatible bucket for uploads (Cloudflare R2, Supabase Storage, AWS). Empty = files in ./media
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
